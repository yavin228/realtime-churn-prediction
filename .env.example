
# Variables d'environnement — architecture de production churn
# --- PostgreSQL ---
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort

# --- Producer (simulateur Kafka) ---
PRODUCER_MODE=continuous
PRODUCER_RATE=20

# --- Hugging Face (chargement du modèle par Spark et l'API) ---
HF_REPO_ID=yavin228/churn-canalplus
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Modèle / scoring ---
SEUIL_CHURN=0.5
MODEL_VERSION=1
TRIGGER_SECONDS=10

# --- FastAPI / JWT ---
JWT_SECRET_KEY=CHANGER_MOI_chaine_aleatoire_longue_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
