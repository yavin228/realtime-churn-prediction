
# .gitignore — realtime-churn-prediction

# --------- Secrets et configuration locale ---------
.env
.env.local
*.pem
*.key
*.crt

# --------- Données (trop volumineuses et sensibles) ---------
data/*.csv
data/*.parquet
data/*.json
!data/.gitkeep

# --------- Backups ---------
*.bak
*.backup
*_backup.*

# --------- Python ---------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --------- Environnements virtuels ---------
venv/
env/
ENV/
.venv/

# --------- Docker (volumes persistants) ---------
postgres_data/
kafka_data/
model_cache/
spark_checkpoints/

# --------- Logs ---------
*.log
logs/

# --------- IDE / Éditeurs ---------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --------- Notebooks Jupyter ---------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --------- Dossier .dist (build artifacts) ---------
.dist/

# --------- MLflow (si local) ---------
mlruns/
mlflow.db
